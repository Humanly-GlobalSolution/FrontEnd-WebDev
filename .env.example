# Copie para .env.local. Reinicie npm run dev depois de alterar.
# demo = exemplos locais; orion = consulta real, sem fallback de demonstração.
CROSSINGS_SOURCE=orion

# Apenas servidor. Informe a raiz do Orion, sem /v2/entities.
# Local: http://localhost:1026
ORION_URL=http://localhost:1026
# ORION_BASE_URL é aceito somente como alternativa legada se ORION_URL não existir.
ORION_FIWARE_SERVICE=farolamigo
ORION_FIWARE_SERVICEPATH=/

# Código de acesso do operador e token administrativo, com no mínimo 32 caracteres.
# Nunca inclua este token no código cliente ou no Git.
ADMIN_API_TOKEN=
# Segredo de geração dos protocolos; gerado por setup:local. Não é o código do operador.
REQUEST_PROTOCOL_SECRET=

# Contrato oficial definido pelo Bruno (Edge).
ORION_CROSSING_TYPE=Cruzamento
ORION_CODE_ATTRIBUTE=codigo
ORION_ADDRESS_ATTRIBUTE=nome
ORION_WIDTH_ATTRIBUTE=largura_m
ORION_TIME_ATTRIBUTE=verde_atual_s

# Entidade de pedidos; atributos oficiais descritos no README.
ORION_REQUEST_TYPE=PedidoRevisao
